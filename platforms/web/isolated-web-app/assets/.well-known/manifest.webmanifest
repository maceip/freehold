{
  "name": "Freehold QUIC Client",
  "short_name": "Freehold",
  "version": "0.1.0",
  "description": "Freehold anycast relay network client with QUIC/Direct Sockets support",
  "start_url": "/",
  "display": "minimal-ui",
  "background_color": "#1a1a2e",
  "theme_color": "#0f3460",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "direct-sockets-private": ["self"]
  }
}
