# Freehold IWA Environment Configuration
#
# To use: Copy this file to .env and fill in values
#
# ED25519KEY - Private key for signing the web bundle
# Format: PEM with escaped newlines
#
# Generate a key with: npm run keygen
# Then copy the contents here (escape newlines with \n)
#
# Example:
# ED25519KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIB8nP5PpWU7HiILHSfh5PYzb5GAcIfHZ+bw6tcd/LZXh\n-----END PRIVATE KEY-----"

ED25519KEY=
