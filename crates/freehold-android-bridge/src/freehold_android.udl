// Freehold Android Bridge - UniFFI Interface Definition
// Types defined via proc-macros in lib.rs:
// - StatusCallback (callback_interface)
// - TunnelConfig (Record)
// - FreeholdTunnel (Object)
// - H3ProxyBridge (Object)
// - ConnectionState (Enum)
// - TunnelError (Error)

namespace freehold_android {
    // Initialize the Rust runtime (call once at app start)
    void init_runtime();

    // Cleanup the Rust runtime
    void shutdown_runtime();
};
